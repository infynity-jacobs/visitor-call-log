# Production environment template.
# Copy to app/backend/.env on the production server and fill in real values.
# This file differs from .env.example mainly in the defaults it documents —
# production should always set DB_SSL appropriately for a managed database,
# a restrictive CORS_ORIGIN, and secrets generated specifically for this host.

NODE_ENV=production
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=visitor_call_log
DB_USER=vcl_app
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=false

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# Generate with: openssl rand -hex 32
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# Restrict to your real domain in production, e.g. https://vcl.yourdomain.com
CORS_ORIGIN=https://vcl.yourdomain.com

APP_VERSION=1.2.1
